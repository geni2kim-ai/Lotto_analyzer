# Android SDK Location (Machine specific)
sdk.dir=C\:\\Users\\user\\AppData\\Local\\Android\\Sdk

# Release Keystore Configuration Template (DO NOT COMMIT REAL PASSWORDS)
# Copy this file to local.properties and update with your local paths
RELEASE_STORE_FILE=path/to/your/keystore.jks
RELEASE_STORE_PASSWORD=YourKeystorePassword
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=YourKeyPassword
